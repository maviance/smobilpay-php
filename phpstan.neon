parameters:
    level: 8
    paths:
        - src
        - tests
        - samples
        - bin/smoke-test
    excludePaths:
        analyseAndScan:
            - vendor
            - .phpunit.cache
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # PHPUnit's TestCase has wide-open mixed types in assertions; level 8
        # complains about those even though our tests are type-safe at the
        # call site. Allow within the tests namespace only.
        -
            message: '#Cannot access offset .* on mixed#'
            paths:
                - tests/*
